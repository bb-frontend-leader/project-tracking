{
  "name": "project-tracking",
  "version": "1.0.0",
  "description": "Sistema de monitoreo de sitios web con alertas por email",
  "main": "dist/main.js",
  "type": "module",
  "imports": {
    "#/*": "./dist/*",
    "#domain/*": "./dist/domain/*",
    "#infrastructure/*": "./dist/infrastructure/*",
    "#presentation/*": "./dist/presentation/*",
    "#utils/*": "./dist/utils/*"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [
    "monitoring",
    "website",
    "email",
    "alerts",
    "cron"
  ],
  "author": "Alejandro Repizo",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.2.3",
    "env-var": "^7.5.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.53.1"
  },
  "engines": {
    "node": ">=22"
  }
}
