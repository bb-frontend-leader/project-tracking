# Configuración del Servidor de Email
# Para Gmail usa: 'gmail'
# Para Outlook/Hotmail usa: 'hotmail'
# IMPORTANTE: Para Gmail, usa una "Contraseña de aplicación"
# https://myaccount.google.com/apppasswords
MAILER_SERVICE=gmail
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Email configuración
EMAIL_FROM=tu-email@gmail.com
EMAIL_TO=destinatario1@example.com,destinatario2@example.com

# Configuración del Monitor
# Cron expression: minutos horas dia mes dia-semana
# Ejemplos:
# */5 * * * * = Cada 5 minutos
# */15 * * * * = Cada 15 minutos
# 0 */1 * * * = Cada hora
# 0 9,17 * * * = A las 9 AM y 5 PM
CHECK_INTERVAL=*/5 * * * *

# Zona horaria (Colombia). Se usa para el cron, los logs y los correos
TIMEZONE=America/Bogota

# Número de fallos consecutivos antes de enviar la primera alerta
MAX_CONSECUTIVE_FAILURES=2

# Minutos entre recordatorios mientras un servicio sigue caído (0 = sin recordatorios)
ALERT_REMINDER_MINUTES=360

# Timeout para cada verificación HTTP (en milisegundos)
HTTP_TIMEOUT=10000

# Archivo con la lista de servicios a monitorear (se relee en cada ciclo).
# Créalo desde la plantilla: cp services.example.json services.json
SERVICES_FILE=services.json

# Días que se conservan los archivos de log diarios (logs/monitor-AAAA-MM-DD.log)
LOG_RETENTION_DAYS=30

# Opcional: URL a la que se hace un GET al final de cada ciclo (p. ej. healthchecks.io).
# Si dejan de llegar pings, el servicio externo avisa que el monitor se cayó.
# HEARTBEAT_URL=https://hc-ping.com/tu-uuid
