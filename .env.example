# Configuración del Servidor de Email
# Para Gmail usa: 'gmail'
# Para Outlook/Hotmail usa: 'hotmail'
# IMPORTANTE: Para Gmail, usa una "Contraseña de aplicación"
# https://myaccount.google.com/apppasswords
MAILER_SERVICE=gmail
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion

# Email configuración
EMAIL_FROM=tu-email@gmail.com
EMAIL_TO=destinatario1@example.com,destinatario2@example.com

# Configuración del Monitor
# Cron expression: minutos horas dia mes dia-semana
# Ejemplos:
# */5 * * * * = Cada 5 minutos
# */15 * * * * = Cada 15 minutos
# 0 */1 * * * = Cada hora
# 0 9,17 * * * = A las 9 AM y 5 PM
CHECK_INTERVAL=*/5 * * * *

# Zona horaria (Colombia)
TIMEZONE=America/Bogota

# Número de fallos consecutivos antes de enviar alerta
MAX_CONSECUTIVE_FAILURES=2

# Timeout para verificaciones HTTP (en milisegundos)
HTTP_TIMEOUT=10000
